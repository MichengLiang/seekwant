    aat:raw """[#great-depression.section, year=1929, type=economic, region=全球]
== 经济大萧条

1929 年华尔街崩盘引发全球萧条。
德国经济雪上加霜，失业率飙升。
经济绝望助长了
xref:纳粹崛起[纳粹崛起, rel=accelerates, weight=0.7, delay=3y]。

""";
    aat:region "全球";
    aat:relativePath "document.adoc";
    aat:role "section";
    aat:startLine 16;
    aat:type "economic";
    aat:year "1929";
    rel:accelerates <urn:aat:doc:cb2326f19571d90604fdc849e1feae1baf446791ecbd64bcba2520c45cc0c1be#heading-l24-o0>.
