    aat:headingLevel 1;
    aat:headingLine 65;
    aat:headline "诺曼底登陆";
    aat:metadataEndLine 64;
    aat:metadataStartLine 64;
    aat:previousSibling <urn:aat:doc:cb2326f19571d90604fdc849e1feae1baf446791ecbd64bcba2520c45cc0c1be#heading-l56-o0>;
    aat:raw """[#d-day.section, year=1944, type=military, region=法国]
== 诺曼底登陆

1944 年 6 月 6 日，盟军登陆诺曼底。
开辟欧洲第二战场。
诺曼底登陆加速了
xref:德国投降[德国投降, rel=leads-to, weight=0.9, delay=11m]。

""";
    aat:region "法国";
    aat:relativePath "document.adoc";
