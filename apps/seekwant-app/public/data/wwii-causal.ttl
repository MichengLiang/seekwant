    aat:raw """[#nazi-rise.section, year=1933, type=political, region=德国]
== 纳粹崛起

希特勒利用民族主义和反犹情绪上台。
纳粹上台直接导致了
xref:绥靖政策[绥靖政策, rel=provokes, weight=0.6] 和
xref:闪击波兰[闪击波兰, rel=leads-to, weight=0.95]。

""";
    aat:region "德国";
    aat:relativePath "document.adoc";
    aat:role "section";
    aat:startLine 24;
    aat:type "political";
    aat:year "1933";
    rel:leads-to <urn:aat:doc:cb2326f19571d90604fdc849e1feae1baf446791ecbd64bcba2520c45cc0c1be#heading-l40-o0>;
