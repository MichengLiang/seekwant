    aat:raw """[#lend-lease.section, year=1941, type=diplomatic, region=美国]
== 租借法案

美国向同盟国提供军事物资。
打破了孤立主义，美国间接参战。
租借法案为
xref:诺曼底登陆[诺曼底登陆, rel=enables, weight=0.6, delay=3y] 奠定物质基础。

""";
    aat:region "美国";
    aat:relativePath "document.adoc";
    aat:role "section";
    aat:startLine 56;
    aat:type "diplomatic";
