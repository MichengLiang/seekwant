    aat:endLine 69;
    aat:generatedAddressLabel "业务层订单与支付";
    aat:headingLevel 1;
    aat:headingLine 68;
    aat:headline "业务层：订单与支付";
    aat:previousSibling <urn:aat:doc:cb2326f19571d90604fdc849e1feae1baf446791ecbd64bcba2520c45cc0c1be#heading-l43-o0>;
