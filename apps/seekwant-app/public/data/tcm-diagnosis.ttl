    aat:previousSibling <urn:aat:doc:cb2326f19571d90604fdc849e1feae1baf446791ecbd64bcba2520c45cc0c1be#heading-l8-o0>;
    aat:raw """[#fengre.section, syndrome-type=外感, severity=轻, season=夏]
== 风热感冒

发热重，恶寒轻，有汗，头胀痛。
咽喉红肿疼痛，咳嗽痰黏黄。
舌苔薄黄，脉浮数。

治法：辛凉解表。
代表方：xref:银翘散[银翘散, rel=treated-by, weight=0.9]。
常用 xref:金银花[金银花, rel=uses-herb, weight=0.9]、
xref:连翘[连翘, rel=uses-herb, weight=0.8] 配伍。

""";
    aat:relativePath "document.adoc";
    aat:role "section";
    aat:season "夏";
    aat:severity "轻";
    aat:startLine 20;
    aat:syndrome-type "外感";
