{
  "name": "seekwant-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "pnpm data:check && vitest run --pool=forks",
    "test:coverage": "vitest run --pool=forks --coverage",
    "e2e": "E2E_PORT=${E2E_PORT:-5175}; export E2E_PORT; start-server-and-test \"vite --host 127.0.0.1 --port $E2E_PORT --strictPort\" http://127.0.0.1:$E2E_PORT \"playwright test\"",
    "data:regen": "tsx scripts/regenerate-data.ts",
    "data:check": "tsx scripts/regenerate-data.ts --check",
    "clean": "rm -rf dist coverage playwright-report test-results"
  },
  "dependencies": {
    "@asciidoctor/core": "^3.0.4",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.9",
    "@tanstack/react-router": "^1.169.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "lucide-react": "^1.17.0",
    "motion": "^12.38.0",
    "n3": "^2.0.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.4",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/n3": "^1.26.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "asciidoc-abundant-tree": "^0.1.10",
    "happy-dom": "^20.9.0",
    "msw": "^2.14.2",
    "start-server-and-test": "^3.0.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
